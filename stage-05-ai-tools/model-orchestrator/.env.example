# ============================================
# 复制本文件为 .env，然后填入你自己的 API Key
# 注意：.env 已被 .gitignore 忽略，不会提交到 GitHub，放心填
# ============================================

# 主模型：DeepSeek（在 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-你的deepseek密钥

# 工人模型：Kimi（在 https://platform.moonshot.cn 申请）
KIMI_API_KEY=sk-你的kimi密钥

# 工人模型：通义千问（在 https://dashscope.console.aliyun.com 申请）
QWEN_API_KEY=sk-你的通义密钥

# 工人模型：豆包（在 https://console.volcengine.com/ark 申请）
DOUBAO_API_KEY=你的豆包密钥
